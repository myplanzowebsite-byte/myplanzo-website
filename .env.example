# ── Database (Supabase) ───────────────────────────────────────────────────────
# Transaction pooler URL — used at runtime on Vercel (port 6543)
# Append exactly: ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection URL — used by `prisma migrate deploy` and `prisma db push` only (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-secure-random-string-min-32-chars"

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ── Google sign-in (Google Identity Services) ─────────────────────────────────
# OAuth 2.0 "Web application" client ID from Google Cloud Console → Credentials.
# Add your origin(s) (e.g. http://localhost:3000) under Authorized JavaScript
# origins. No client secret is needed for the ID-token flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── SMS (MSG91, DLT-compliant) ────────────────────────────────────────────────
# SMS_PROVIDER=live  → sends real SMS via MSG91's Flow API
# SMS_PROVIDER=mock  → OTP shown on-screen (default, safe for dev/staging)
SMS_PROVIDER="mock"
# From the MSG91 panel. SENDER_ID is your 6-char DLT-approved header.
# OTP/CHAT flow IDs come from the MSG91 Flows linked to your DLT templates.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_OTP_FLOW_ID=""
MSG91_CHAT_FLOW_ID=""
# Additional DLT-approved flow IDs — leave blank to no-op that path.
MSG91_PASSWORD_RESET_FLOW_ID=""
MSG91_WELCOME_FLOW_ID=""
MSG91_VENDOR_BOOKING_FLOW_ID=""
MSG91_BOOKING_CONFIRMATION_FLOW_ID=""
MSG91_BOOKING_REMINDER_FLOW_ID=""
MSG91_NEW_VENDORS_FLOW_ID=""
MSG91_ENQUIRY_FLOW_ID=""

# ── Vercel Cron ───────────────────────────────────────────────────────────────
# Random string. Set the same value in your Vercel project env vars so the
# scheduled job at /api/cron/booking-reminders authenticates.
CRON_SECRET=""
